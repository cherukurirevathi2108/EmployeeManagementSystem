<%
    String cp = request.getContextPath();
    String role = util.Security.role(session);
    String csrf = util.Security.csrfToken(session);
    String backHref = "ADMIN".equals(role) ? cp + "/admin" : "HR".equals(role) ? cp + "/hr"
            : "MANAGER".equals(role) ? cp + "/managerDashboard.jsp" : cp + "/employee_dashboard.jsp";
    String me = util.Html.esc(util.Security.userName(session));
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %> - SmartOffice</title>
<style>
:root{--bg:#f4f6fb;--card:#fff;--ink:#1e293b;--mute:#64748b;--line:#e2e8f0;--brand:#4f46e5;--ok:#16a34a;--bad:#dc2626;--warn:#d97706}
@media (prefers-color-scheme:dark){:root{--bg:#0f172a;--card:#1e293b;--ink:#e2e8f0;--mute:#94a3b8;--line:#334155}}
*{box-sizing:border-box}body{margin:0;font-family:"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:14px}
header{background:var(--brand);color:#fff;padding:12px 24px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
header h1{font-size:17px;margin:0;font-weight:600}header nav{display:flex;gap:6px;flex-wrap:wrap;flex:1}
header a{color:#e0e7ff;text-decoration:none;padding:6px 11px;border-radius:7px}header a:hover,header a.on{background:rgba(255,255,255,.18);color:#fff}
header .who{font-size:12px;opacity:.85}
main{max-width:1280px;margin:22px auto;padding:0 20px}
h2{font-size:18px;margin:0 0 14px}h3{font-size:15px;margin:0 0 10px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:18px}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));margin-bottom:18px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
.stat b{display:block;font-size:28px}.stat span{color:var(--mute)}
.two{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(380px,1fr))}
table{width:100%;border-collapse:collapse}th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{font-size:12px;text-transform:uppercase;color:var(--mute);letter-spacing:.03em}
.scroll{overflow-x:auto}
form.filters{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
label{display:flex;flex-direction:column;font-size:12px;color:var(--mute);gap:4px}
input,select,textarea{font:inherit;padding:7px 9px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink)}
button,.btn{font:inherit;background:var(--brand);color:#fff;border:0;border-radius:8px;padding:8px 14px;cursor:pointer;text-decoration:none;display:inline-block}
button.danger{background:var(--bad)}button.ghost,.btn.ghost{background:transparent;color:var(--brand);border:1px solid var(--brand)}
.alert{padding:10px 14px;border-radius:8px;margin-bottom:14px}.alert.err{background:#fee2e2;color:#991b1b}.alert.ok{background:#dcfce7;color:#166534}.alert.warn{background:#fef3c7;color:#92400e}
.tag{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600;background:var(--line)}
.tag.SUCCESS,.tag.LOGIN,.tag.ACTIVE,.tag.LOW{background:#dcfce7;color:#166534}
.tag.FAILED,.tag.FAILED_LOGIN,.tag.CRITICAL,.tag.HIGH,.tag.DELETE,.tag.INACTIVE{background:#fee2e2;color:#991b1b}
.tag.MEDIUM,.tag.SESSION_EXPIRED,.tag.UPDATE{background:#fef3c7;color:#92400e}
.tag.CREATE,.tag.LOGOUT{background:#e0e7ff;color:#3730a3}
.mute{color:var(--mute)}.pager{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap;align-items:center}
.pager a{padding:5px 10px;border:1px solid var(--line);border-radius:7px;text-decoration:none;color:var(--ink)}.pager a.cur{background:var(--brand);color:#fff;border-color:var(--brand)}
code,pre{font-family:Consolas,monospace;font-size:12px}pre{margin:0;white-space:pre-wrap;word-break:break-word;max-width:340px}
.fields{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.fields .full{grid-column:1/-1}.chk{flex-direction:row;align-items:center;gap:6px;color:var(--ink);font-size:13px}
</style>
</head>
<body>
<header>
  <h1>&#128737; <%= pageTitle %></h1>
  <nav>
    <% if ("ADMIN".equals(role) || "HR".equals(role)) { %>
      <a href="<%= cp %>/system/dashboard" class="<%= "dashboard".equals(active) ? "on" : "" %>">Dashboard</a>
    <% } %>
    <a href="<%= cp %>/system/audit-logs" class="<%= "audit".equals(active) ? "on" : "" %>"><%= ("ADMIN".equals(role) || "HR".equals(role)) ? "Audit Logs" : "My Activity" %></a>
    <% if ("ADMIN".equals(role) || "HR".equals(role)) { %>
      <a href="<%= cp %>/system/login-history" class="<%= "login".equals(active) ? "on" : "" %>">Login History</a>
      <a href="<%= cp %>/system/errors" class="<%= "errors".equals(active) ? "on" : "" %>">System Errors</a>
    <% } %>
    <% if ("ADMIN".equals(role)) { %>
      <a href="<%= cp %>/system/settings" class="<%= "settings".equals(active) ? "on" : "" %>">Settings &amp; Users</a>
      <a href="<%= cp %>/system/backups" class="<%= "backups".equals(active) ? "on" : "" %>">Backups</a>
    <% } %>
  </nav>
  <span class="who"><%= me %> (<%= util.Html.esc(role) %>)</span>
  <a href="<%= backHref %>">&larr; Back to app</a>
</header>
<main>
