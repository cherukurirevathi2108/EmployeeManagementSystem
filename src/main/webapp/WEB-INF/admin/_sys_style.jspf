<style>
.sx-ic{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.sys{--s-card:#fff;--s-ink:#0f172a;--s-ink2:#334155;--s-mute:#64748b;--s-line:#e2e8f0;--s-line2:#eef2f7;--s-soft:#f8fafc;--s-brand:#4f46e5;--s-ok:#16a34a;--s-bad:#dc2626;--s-ok-t:#15803d;--s-bad-t:#b91c1c;--s-warn-t:#b45309;--s-info-t:#4338ca;color:var(--s-ink);font-size:14px}
.sys *{box-sizing:border-box}

/* tabs */
.sys .sys-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 20px;padding:6px;background:var(--s-soft);border:1px solid var(--s-line);border-radius:12px}
.sys .sys-tab{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--s-mute);border:0;box-shadow:none;border-radius:9px;padding:9px 14px;font-size:13px;font-weight:600;letter-spacing:0;cursor:pointer;transition:background .15s,color .15s}
.sys .sys-tab:hover{background:#fff;color:var(--s-ink);transform:none}
.sys .sys-tab.on{background:#fff;color:var(--s-info-t);box-shadow:0 1px 3px rgba(15,23,42,.12)}
.sys #sysBody{min-height:160px;transition:opacity .15s}
.sys #sysBody.sys-loading{opacity:.45;pointer-events:none}
.sys .sys-sub{margin:0 0 16px;font-size:13px;color:var(--s-mute)}
.sys .sys-spin{padding:60px 0;text-align:center;color:var(--s-mute)}

/* cards */
.sys .card{background:var(--s-card);border:1px solid var(--s-line);border-radius:14px;box-shadow:0 1px 2px rgba(15,23,42,.04);margin:0 0 20px;padding:0}
.sys .card-h{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid var(--s-line)}
.sys h3{margin:0;font-size:15px;font-weight:700;letter-spacing:-.1px;color:var(--s-ink)}
.sys .card-h p,.sys .hint{margin:3px 0 0;font-size:12px;color:var(--s-mute);font-weight:400}
.sys .card-b{padding:20px}
.sys .card-f{padding:12px 20px;border-top:1px solid var(--s-line);font-size:13px}
.sys .card-f a{color:var(--s-info-t);font-weight:600;text-decoration:none}
.sys .card-f a:hover{text-decoration:underline}
.sys .two{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(100%,430px),1fr));margin:0 0 20px}
.sys .two>.card{margin:0}
.sys .count{display:inline-block;margin-left:8px;padding:2px 10px;border-radius:99px;background:rgba(79,70,229,.12);color:var(--s-info-t);font-size:12px;font-weight:700;vertical-align:1px}

/* stat tiles */
.sys .sx-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:12px;margin:0 0 20px}
.sys .sx-stat{display:flex;align-items:center;gap:12px;min-width:0;background:var(--s-card);border:1px solid var(--s-line);border-radius:14px;padding:14px 16px;box-shadow:0 1px 2px rgba(15,23,42,.04);transition:transform .15s,box-shadow .15s}
.sys .sx-stat:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(15,23,42,.09)}
.sys .sx-stat .ico{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;flex:none}
.sys .sx-stat .ico .sx-ic{width:21px;height:21px}
.sys .sx-stat b{display:block;font-size:26px;line-height:1.1;font-weight:700}
.sys .sx-stat span{font-size:12px;color:var(--s-mute);line-height:1.3}
.sys .t-indigo .ico{background:rgba(79,70,229,.12);color:#6366f1}.sys .t-green .ico{background:rgba(22,163,74,.13);color:#16a34a}
.sys .t-slate .ico{background:rgba(100,116,139,.15);color:#64748b}.sys .t-violet .ico{background:rgba(124,58,237,.12);color:#7c3aed}
.sys .t-blue .ico{background:rgba(37,99,235,.12);color:#2563eb}.sys .t-red .ico{background:rgba(220,38,38,.12);color:#dc2626}

/* tables */
.sys .tbl-wrap{overflow-x:auto}
.sys .card>.tbl-wrap:last-child{border-radius:0 0 14px 14px}
.sys table{width:100%;min-width:0;border-collapse:separate;border-spacing:0}
.sys th{position:static;background:var(--s-soft);color:var(--s-mute);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;padding:11px 16px;text-align:left;border-bottom:1px solid var(--s-line);white-space:nowrap}
.sys td{max-width:none;overflow-wrap:normal;padding:12px 16px;border-bottom:1px solid var(--s-line2);vertical-align:top;font-size:13px;color:var(--s-ink)}
.sys tbody tr:hover td{background:var(--s-soft)}
.sys tbody tr:last-child td{border-bottom:0}
.sys tfoot th{border-top:1px solid var(--s-line);border-bottom:0;color:var(--s-ink);font-size:12px;text-transform:none;letter-spacing:0}
.sys .nowrap{white-space:nowrap}.sys .mute{color:var(--s-mute)}.sys .small{font-size:12px}
.sys .ts{white-space:nowrap;color:var(--s-ink2);font-variant-numeric:tabular-nums}
.sys td.empty{text-align:center;color:var(--s-mute);padding:38px 16px}
.sys td.empty .sx-ic{width:30px;height:30px;display:block;margin:0 auto 8px;opacity:.55}
.sys .uid{font-weight:600}
.sys .ua{max-width:320px;color:var(--s-mute);font-size:12px;word-break:break-word}
.sys .msg{max-width:420px;word-break:break-word}
.sys .bar{height:6px;border-radius:99px;background:var(--s-line);overflow:hidden;min-width:90px}
.sys .bar i{display:block;height:100%;background:linear-gradient(90deg,#16a34a,#22c55e);border-radius:99px}
.sys .person{display:flex;align-items:center;gap:10px}
.sys .person .av{width:30px;height:30px;border-radius:50%;background:rgba(79,70,229,.14);color:var(--s-info-t);display:grid;place-items:center;font-size:12px;font-weight:700;flex:none}
.sys .role{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.06em;color:var(--s-info-t);background:rgba(79,70,229,.12);padding:2px 8px;border-radius:99px}

/* tags */
.sys .tag{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:99px;font-size:11px;font-weight:700;letter-spacing:.02em;background:rgba(100,116,139,.14);color:var(--s-mute);white-space:nowrap}
.sys .tag::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.sys .tag.SUCCESS,.sys .tag.LOGIN,.sys .tag.ACTIVE,.sys .tag.LOW{background:rgba(22,163,74,.13);color:var(--s-ok-t)}
.sys .tag.FAILED,.sys .tag.FAILED_LOGIN,.sys .tag.CRITICAL,.sys .tag.HIGH,.sys .tag.DELETE,.sys .tag.INACTIVE,.sys .tag.ACCESS_DENIED,.sys .tag.CSRF_FAILURE,.sys .tag.REPEATED_FAILED_LOGIN{background:rgba(220,38,38,.12);color:var(--s-bad-t)}
.sys .tag.MEDIUM,.sys .tag.UNKNOWN_USER_LOGIN,.sys .tag.SESSION_EXPIRED,.sys .tag.UPDATE,.sys .tag.RESTORE,.sys .tag.EXPORT{background:rgba(217,119,6,.14);color:var(--s-warn-t)}
.sys .tag.CREATE,.sys .tag.LOGOUT{background:rgba(79,70,229,.12);color:var(--s-info-t)}

/* forms & buttons */
.sys form.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;align-items:end}
.sys .factions{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.sys .factions .push{margin-left:auto}
.sys label{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:var(--s-ink2)}
.sys label em{font-style:normal;font-weight:400;color:var(--s-mute)}
.sys input,.sys select,.sys textarea{font:inherit;font-size:13px;width:100%;margin:0;padding:9px 12px;border:1.5px solid var(--s-line);border-radius:9px;background:#fff;color:var(--s-ink);font-weight:400;transition:border-color .15s,box-shadow .15s}
.sys input:focus,.sys select:focus,.sys textarea:focus{outline:none;border-color:var(--s-brand);box-shadow:0 0 0 4px rgba(79,70,229,.14)}
.sys button,.sys .btn{font:inherit;font-size:13px;font-weight:600;letter-spacing:0;display:inline-flex;align-items:center;justify-content:center;gap:7px;background:linear-gradient(135deg,#4f46e5,#4338ca);color:#fff;border:0;border-radius:9px;padding:9px 16px;cursor:pointer;text-decoration:none;white-space:nowrap;box-shadow:0 4px 10px rgba(79,70,229,.25);transition:transform .1s,box-shadow .15s,opacity .15s}
.sys button:hover,.sys .btn:hover{transform:translateY(-1px)}
.sys button:disabled{opacity:.6;cursor:wait;transform:none}
.sys button.danger,.sys .btn.danger{background:linear-gradient(135deg,#ef4444,#dc2626);box-shadow:0 4px 10px rgba(220,38,38,.22)}
.sys button.ghost,.sys .btn.ghost{background:#fff;color:var(--s-info-t);border:1.5px solid var(--s-line);box-shadow:none}
.sys button.ghost:hover,.sys .btn.ghost:hover{background:var(--s-soft);border-color:var(--s-brand)}
.sys .sm{padding:6px 12px;font-size:12px}
.sys .fields{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.sys .fields .full{grid-column:1/-1}
.sys .chips{display:flex;flex-wrap:wrap;gap:8px}
.sys label.chip{position:relative;flex-direction:row;cursor:pointer}
.sys .chip input{position:absolute;opacity:0;pointer-events:none;width:auto}
.sys .chip span{padding:7px 15px;border:1.5px solid var(--s-line);border-radius:99px;font-size:12px;font-weight:700;color:var(--s-mute);background:#fff;transition:.15s}
.sys .chip:hover span{border-color:var(--s-brand)}
.sys .chip input:checked+span{background:var(--s-brand);border-color:var(--s-brand);color:#fff}
.sys .chip input:focus-visible+span{box-shadow:0 0 0 4px rgba(79,70,229,.2)}
.sys label.switch{position:relative;flex-direction:row;align-items:center;gap:12px;cursor:pointer;font-size:13px;color:var(--s-ink);font-weight:600}
.sys .switch input{position:absolute;opacity:0;width:auto}
.sys .switch i{width:42px;height:23px;border-radius:99px;background:#cbd5e1;position:relative;transition:.2s;flex:none}
.sys .switch i::after{content:"";position:absolute;top:3px;left:3px;width:17px;height:17px;border-radius:50%;background:#fff;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
.sys .switch input:checked+i{background:var(--s-brand)}.sys .switch input:checked+i::after{transform:translateX(19px)}
.sys .switch input:focus-visible+i{box-shadow:0 0 0 4px rgba(79,70,229,.2)}
.sys .savebar{position:sticky;bottom:12px;z-index:5;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;background:#fff;border:1px solid var(--s-line);border-radius:14px;padding:12px 18px;box-shadow:0 8px 24px rgba(15,23,42,.14);margin:0 0 20px}
.sys .restore{display:flex;gap:6px;align-items:center}.sys .restore input{min-width:230px}

/* alerts & details */
.sys .alert{display:flex;gap:12px;align-items:flex-start;padding:12px 16px;border-radius:12px;margin:0 0 18px;border:1px solid;font-size:13px}
.sys .alert .sx-ic{margin-top:1px}.sys .alert ul{margin:6px 0 0;padding-left:18px}.sys .alert a{color:inherit;font-weight:700}
.sys .alert.err{background:rgba(220,38,38,.07);border-color:rgba(220,38,38,.28);color:var(--s-bad-t)}
.sys .alert.ok{background:rgba(22,163,74,.08);border-color:rgba(22,163,74,.3);color:var(--s-ok-t)}
.sys .alert.warn{background:rgba(217,119,6,.08);border-color:rgba(217,119,6,.3);color:var(--s-warn-t)}
.sys .chg summary{white-space:nowrap;cursor:pointer;color:var(--s-info-t);font-weight:600;font-size:12px;list-style:none}
.sys .chg summary::-webkit-details-marker{display:none}
.sys .chg summary::before{content:"\25B8  "}.sys .chg[open] summary::before{content:"\25BE  "}
.sys .chg .lbl{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--s-mute);margin:8px 0 3px}
.sys code,.sys pre{font-family:Consolas,monospace;font-size:12px}
.sys code{background:var(--s-soft);border:1px solid var(--s-line);padding:1px 6px;border-radius:6px}
.sys pre{margin:0;white-space:pre-wrap;word-break:break-word;max-width:340px;padding:8px 10px;border-radius:8px}
.sys pre.before{background:rgba(220,38,38,.08);border-left:3px solid var(--s-bad)}
.sys pre.after{background:rgba(22,163,74,.09);border-left:3px solid var(--s-ok)}
.sys .kv{display:grid;grid-template-columns:auto 1fr;gap:12px 22px;margin:0;font-size:13px}
.sys .kv dt{color:var(--s-mute)}.sys .kv dd{margin:0;font-weight:600;word-break:break-word}
.sys .pager{display:flex;gap:6px;flex-wrap:wrap;align-items:center;padding:14px 20px;border-top:1px solid var(--s-line)}
.sys .pager a{padding:6px 12px;border:1px solid var(--s-line);border-radius:8px;text-decoration:none;color:var(--s-ink2);font-size:13px;transition:.15s}
.sys .pager a:hover{border-color:var(--s-brand);color:var(--s-info-t)}
.sys .pager a.cur{background:var(--s-brand);color:#fff;border-color:var(--s-brand);font-weight:700}
.sys .logo-box{display:flex;gap:28px;flex-wrap:wrap;align-items:flex-start}
.sys .logo-prev{display:block;max-width:280px;max-height:120px;object-fit:contain;border:1px solid var(--s-line);border-radius:12px;padding:14px;background:var(--s-soft)}
.sys .logo-empty{width:280px;height:120px;border:1.5px dashed var(--s-line);border-radius:12px;display:grid;place-items:center;color:var(--s-mute);font-size:12px;background:var(--s-soft)}
.sys input[type=file]{padding:8px 10px;background:#fff;cursor:pointer}
.sys button.danger-ghost{color:var(--s-bad-t)}.sys button.danger-ghost:hover{border-color:var(--s-bad);background:rgba(220,38,38,.06)}
/* system settings screen */
.sys .set-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.sys .set-head p{margin:4px 0 0;font-size:13px;color:var(--s-mute)}
.sys .set-sec{margin:30px 0 14px;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--s-mute)}
.sys .set-label{font-size:12px;font-weight:600;color:var(--s-ink2);margin:0 0 8px}
.sys .set-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;align-items:start}
.sys .set-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.sys .set-row4{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px;align-items:start}
.sys .set-logo-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.sys .logo-thumb{width:68px;height:68px;border:1px solid var(--s-line);border-radius:12px;background:#fff;display:grid;place-items:center;overflow:hidden;color:var(--s-mute);font-size:11px;flex:none}
.sys .logo-thumb img{max-width:100%;max-height:100%;object-fit:contain;padding:6px;display:block}
.sys #sxLogoMsg[data-kind=ok]{color:var(--s-ok-t)}.sys #sxLogoMsg[data-kind=err]{color:var(--s-bad-t)}
.sys .daytiles{display:flex;gap:10px;flex-wrap:wrap}
.sys label.daytile{flex-direction:column;align-items:center;gap:8px;min-width:54px;padding:11px 10px;border:1px solid var(--s-line);border-radius:10px;background:#fff;cursor:pointer;font-weight:500;color:var(--s-ink);font-size:13px;transition:border-color .15s,background .15s}
.sys label.daytile:hover{border-color:var(--s-brand)}
.sys .daytile input{width:auto;margin:0;accent-color:var(--s-brand);cursor:pointer}
.sys .set-actions{display:flex;gap:10px;margin-top:32px;flex-wrap:wrap}
@media(max-width:900px){.sys .set-grid,.sys .set-row{grid-template-columns:1fr}}
@media(max-width:760px){.sys .factions .push{margin-left:0}.sys .restore{flex-wrap:wrap}.sys .sys-tab{padding:8px 11px}}
</style>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="sx-i-dash" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></symbol>
<symbol id="sx-i-file" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></symbol>
<symbol id="sx-i-login" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></symbol>
<symbol id="sx-i-alert" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></symbol>
<symbol id="sx-i-sliders" viewBox="0 0 24 24"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></symbol>
<symbol id="sx-i-db" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></symbol>
<symbol id="sx-i-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
<symbol id="sx-i-ucheck" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></symbol>
<symbol id="sx-i-ux" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></symbol>
<symbol id="sx-i-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></symbol>
<symbol id="sx-i-ok" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></symbol>
<symbol id="sx-i-x" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></symbol>
<symbol id="sx-i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></symbol>
<symbol id="sx-i-inbox" viewBox="0 0 24 24"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></symbol>
<symbol id="sx-i-menu" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></symbol>
<symbol id="sx-i-dl" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></symbol>
<symbol id="sx-i-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></symbol>
<symbol id="sx-i-back" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></symbol>
</defs></svg>
